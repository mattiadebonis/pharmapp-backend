{
  "info": {
    "name": "Pharma Reminder · Therapy Data",
    "description": "Endpoints for the aggregated therapy-data view + clinical PDF export. Use the {{base_url}} and {{jwt}} environment variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000"},
    {"key": "jwt", "value": ""},
    {"key": "profile_id", "value": "11111111-1111-1111-1111-111111111111"}
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{jwt}}", "type": "string"}]
  },
  "item": [
    {
      "name": "GET therapy-data · default 28d",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v2/profiles/{{profile_id}}/therapy-data",
          "host": ["{{base_url}}"],
          "path": ["v2", "profiles", "{{profile_id}}", "therapy-data"]
        }
      }
    },
    {
      "name": "GET therapy-data · 7d",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v2/profiles/{{profile_id}}/therapy-data?period=7d",
          "host": ["{{base_url}}"],
          "path": ["v2", "profiles", "{{profile_id}}", "therapy-data"],
          "query": [{"key": "period", "value": "7d"}]
        }
      }
    },
    {
      "name": "GET therapy-data · 12mo",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v2/profiles/{{profile_id}}/therapy-data?period=12mo",
          "host": ["{{base_url}}"],
          "path": ["v2", "profiles", "{{profile_id}}", "therapy-data"],
          "query": [{"key": "period", "value": "12mo"}]
        }
      }
    },
    {
      "name": "GET therapy-data · all",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v2/profiles/{{profile_id}}/therapy-data?period=all",
          "host": ["{{base_url}}"],
          "path": ["v2", "profiles", "{{profile_id}}", "therapy-data"],
          "query": [{"key": "period", "value": "all"}]
        }
      }
    },
    {
      "name": "GET therapy-data · custom range",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v2/profiles/{{profile_id}}/therapy-data?period=custom&from=2026-01-01&to=2026-04-20",
          "host": ["{{base_url}}"],
          "path": ["v2", "profiles", "{{profile_id}}", "therapy-data"],
          "query": [
            {"key": "period", "value": "custom"},
            {"key": "from", "value": "2026-01-01"},
            {"key": "to", "value": "2026-04-20"}
          ]
        }
      }
    },
    {
      "name": "GET therapy-data · adherence only",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v2/profiles/{{profile_id}}/therapy-data?include=adherence",
          "host": ["{{base_url}}"],
          "path": ["v2", "profiles", "{{profile_id}}", "therapy-data"],
          "query": [{"key": "include", "value": "adherence"}]
        }
      }
    },
    {
      "name": "GET therapy-data · PDF report (28d)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v2/profiles/{{profile_id}}/therapy-data/report.pdf?period=28d",
          "host": ["{{base_url}}"],
          "path": ["v2", "profiles", "{{profile_id}}", "therapy-data", "report.pdf"],
          "query": [{"key": "period", "value": "28d"}]
        }
      }
    },
    {
      "name": "GET therapy-data · PDF report (12mo)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v2/profiles/{{profile_id}}/therapy-data/report.pdf?period=12mo",
          "host": ["{{base_url}}"],
          "path": ["v2", "profiles", "{{profile_id}}", "therapy-data", "report.pdf"],
          "query": [{"key": "period", "value": "12mo"}]
        }
      }
    }
  ]
}
